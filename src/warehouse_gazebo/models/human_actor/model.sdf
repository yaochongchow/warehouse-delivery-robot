<?xml version="1.0"?>
<sdf version="1.6">
  <!-- This model is meant to be used as a reference for actor definitions
       in the warehouse.world file. Actors must be defined at the world level. -->
  <model name="human_actor_model">
    <static>true</static>
    <link name="body">
      <pose>0 0 0.9 0 0 0</pose>
      <visual name="torso">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.3 0.15 0.5</size></box></geometry>
        <material>
          <ambient>0.8 0.4 0.1 1</ambient>
          <diffuse>0.9 0.5 0.2 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.2</radius><length>1.8</length></cylinder></geometry>
        <pose>0 0 0 0 0 0</pose>
      </collision>
    </link>
    <link name="head">
      <pose>0 0 1.35 0 0 0</pose>
      <visual name="visual">
        <geometry><sphere><radius>0.12</radius></sphere></geometry>
        <material>
          <ambient>0.9 0.75 0.6 1</ambient>
          <diffuse>0.95 0.8 0.65 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
