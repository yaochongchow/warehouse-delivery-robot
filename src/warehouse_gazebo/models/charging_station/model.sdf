<?xml version="1.0"?>
<sdf version="1.6">
  <model name="charging_station">
    <static>true</static>

    <!-- Charging pad -->
    <link name="pad">
      <pose>0 0 0.02 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>0.6 0.5 0.04</size></box></geometry>
        <material>
          <ambient>0.8 0.7 0.1 1</ambient>
          <diffuse>0.9 0.8 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.6 0.5 0.04</size></box></geometry>
      </collision>
    </link>

    <!-- Charger unit (wall-mounted box) -->
    <link name="charger_box">
      <pose>0.0 -0.3 0.4 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>0.3 0.1 0.4</size></box></geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.3 0.1 0.4</size></box></geometry>
      </collision>
    </link>

    <!-- Yellow indicator light -->
    <link name="indicator">
      <pose>0.0 -0.24 0.62 0 0 0</pose>
      <visual name="visual">
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
        <material>
          <ambient>0.9 0.9 0.0 1</ambient>
          <diffuse>1.0 1.0 0.0 1</diffuse>
          <emissive>0.5 0.5 0.0 1</emissive>
        </material>
      </visual>
    </link>

  </model>
</sdf>
