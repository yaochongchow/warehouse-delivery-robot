<?xml version="1.0"?>
<sdf version="1.6">
  <model name="delivery_station">
    <static>true</static>

    <!-- Drop zone platform -->
    <link name="platform">
      <pose>0 0 0.05 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>0.8 0.6 0.1</size></box></geometry>
        <material>
          <ambient>0.2 0.3 0.7 1</ambient>
          <diffuse>0.2 0.4 0.8 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.8 0.6 0.1</size></box></geometry>
      </collision>
    </link>

    <!-- Blue marker pole -->
    <link name="marker_pole">
      <pose>0.0 0.0 0.6 0 0 0</pose>
      <visual name="visual">
        <geometry><cylinder><radius>0.02</radius><length>1.0</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.2 0.8 1</ambient>
          <diffuse>0.1 0.3 0.9 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Blue marker flag -->
    <link name="marker_flag">
      <pose>0.08 0.0 1.08 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>0.15 0.02 0.1</size></box></geometry>
        <material>
          <ambient>0.1 0.2 0.8 1</ambient>
          <diffuse>0.1 0.3 0.9 1</diffuse>
        </material>
      </visual>
    </link>

  </model>
</sdf>
