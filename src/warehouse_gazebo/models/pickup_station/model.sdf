<?xml version="1.0"?>
<sdf version="1.6">
  <model name="pickup_station">
    <static>true</static>

    <!-- Table surface -->
    <link name="table">
      <pose>0 0 0.4 0 0 0</pose>
      <visual name="visual">
        <geometry><box><size>0.8 0.6 0.05</size></box></geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.7 0.7 0.7 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.8 0.6 0.05</size></box></geometry>
      </collision>
    </link>

    <!-- Table legs -->
    <link name="leg1">
      <pose>0.35 0.25 0.19 0 0 0</pose>
      <visual name="visual">
        <geometry><cylinder><radius>0.025</radius><length>0.375</length></cylinder></geometry>
        <material><diffuse>0.4 0.4 0.4 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.025</radius><length>0.375</length></cylinder></geometry>
      </collision>
    </link>

    <link name="leg2">
      <pose>-0.35 0.25 0.19 0 0 0</pose>
      <visual name="visual">
        <geometry><cylinder><radius>0.025</radius><length>0.375</length></cylinder></geometry>
        <material><diffuse>0.4 0.4 0.4 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.025</radius><length>0.375</length></cylinder></geometry>
      </collision>
    </link>

    <link name="leg3">
      <pose>0.35 -0.25 0.19 0 0 0</pose>
      <visual name="visual">
        <geometry><cylinder><radius>0.025</radius><length>0.375</length></cylinder></geometry>
        <material><diffuse>0.4 0.4 0.4 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.025</radius><length>0.375</length></cylinder></geometry>
      </collision>
    </link>

    <link name="leg4">
      <pose>-0.35 -0.25 0.19 0 0 0</pose>
      <visual name="visual">
        <geometry><cylinder><radius>0.025</radius><length>0.375</length></cylinder></geometry>
        <material><diffuse>0.4 0.4 0.4 1</diffuse></material>
      </visual>
      <collision name="collision">
        <geometry><cylinder><radius>0.025</radius><length>0.375</length></cylinder></geometry>
      </collision>
    </link>

    <!-- Green marker pole -->
    <link name="marker_pole">
      <pose>0.0 0.0 0.7 0 0 0</pose>
      <visual name="visual">
        <geometry><cylinder><radius>0.02</radius><length>0.55</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.8 0.1 1</ambient>
          <diffuse>0.1 0.9 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Green marker flag -->
    <link name="marker_flag">
      <pose>0.08 0.0 0.95 0 0 0</pose>
