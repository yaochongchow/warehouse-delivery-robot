<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="MultiGoalPatrol">

      <!-- Goal 1: pickup_A -->
      <RecoveryNode number_of_retries="3" name="GoToGoal1">
        <PipelineSequence name="NavToGoal1">
          <RateController hz="1.0">
            <ComputePathToPose goal="{goal_1}" path="{path}" planner_id="GridBased"/>
          </RateController>
          <FollowPath path="{path}" controller_id="FollowPath"/>
        </PipelineSequence>
        <ReactiveFallback name="Recovery1">
          <GoalUpdated/>
          <RoundRobin>
            <ClearEntireCostmap name="ClearLocal" service_name="local_costmap/clear_entirely_local_costmap"/>
            <Spin spin_dist="1.57"/>
            <Wait wait_duration="3"/>
          </RoundRobin>
        </ReactiveFallback>
      </RecoveryNode>

