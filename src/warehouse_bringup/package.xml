<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>warehouse_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch files for the warehouse delivery robot</description>
  <maintainer email="ycchow@example.com">ycchow</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>warehouse_robot_description</exec_depend>
  <exec_depend>warehouse_gazebo</exec_depend>
  <exec_depend>warehouse_navigation</exec_depend>
  <exec_depend>warehouse_slam</exec_depend>
  <exec_depend>warehouse_task_manager</exec_depend>
  <exec_depend>warehouse_dashboard</exec_depend>

  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
